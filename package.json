{
    "name": "photos-bridge",
    "private": true,
    "version": "0.1.0",
    "workspaces": [
        "apps/server"
    ],
    "scripts": {
        "build:server": "npm --workspace @photos-bridge/server run build",
        "generate:app-icon": "node scripts/generate-app-icon.mjs",
        "test:retriever": "python -m pytest --rootdir apps/retriever apps/retriever/tests",
        "test:server": "npm --workspace @photos-bridge/server test",
        "dev:server": "npm --workspace @photos-bridge/server run dev",
        "lint": "eslint . --ext .ts,.js,.json,.cjs",
        "lint:fix": "eslint . --ext .ts,.js,.json,.cjs --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsonc": "^2.18.2",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-sort-keys-fix": "^1.1.2",
        "jsonc-eslint-parser": "^2.4.0",
        "prettier": "^3.7.4"
    }
}
