{
    "name": "@photos-bridge/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "npm run build:ui && tsx src/dev.ts",
        "start": "node dist/src/index.js",
        "build": "npm run build:ui && tsc -p tsconfig.json",
        "test": "node --import tsx --test tests/*.test.ts",
        "build:ui": "vue-tsc -p ui/tsconfig.json && vite build",
        "dev:ui": "vite --host 127.0.0.1",
        "pretest": "npm run build:ui",
        "typecheck": "vue-tsc -p ui/tsconfig.json && tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@types/qrcode": "^1.5.6",
        "better-sqlite3": "^12.2.0",
        "express": "^5.1.0",
        "qrcode": "^1.5.4",
        "vue": "^3.5.44",
        "vue-router": "^4.6.4",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/express": "^5.0.3",
        "@types/node": "^24.1.0",
        "@types/supertest": "^6.0.3",
        "@types/ws": "^8.18.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "less": "^4.9.1",
        "supertest": "^7.1.4",
        "tsx": "^4.20.3",
        "typescript": "^5.9.2",
        "vite": "^8.3.5",
        "vue-tsc": "^3.3.13"
    }
}
